{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate preset for SigNoz repositories.",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "group:allNonMajor",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "UTC",
  "schedule": ["* 0-7 * * 1"],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 0,
  "automerge": false,
  "dependencyDashboard": true,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": []
  },
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Major updates wait for approval on the dependency dashboard.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
